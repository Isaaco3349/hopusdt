# Firebase (Project settings → Your apps → Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# TRON TRC-20 USDT deposit (use Binance TRON deposit for ops — do not label "Binance" on the site)
BRIDGE_DEPOSIT_ADDRESS=

# Admin Firebase Auth email (must match firestore.rules)
BRIDGE_ADMIN_EMAIL=

# Branding
BRIDGE_APP_NAME=USDT Hop
BRIDGE_TAGLINE=Send USDT on TRON, receive USDT on BNB Smart Chain. Low flat fee.
BRIDGE_OPERATOR_NOTE=Desk operated from Nigeria. Payouts in BEP20 USDT.
BRIDGE_SUPPORT_CONTACT=whatsapp:+234XXXXXXXXXX

# Economics (keep firestore.rules in sync — run npm run build after changes)
BRIDGE_FEE=1
BRIDGE_MIN_AMOUNT=2

# Telegram alerts (Vercel env only — not in firebase-config.js)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Visitor pings off by default; set true only if you want a Telegram on every new session
BRIDGE_NOTIFY_VISITS=false
