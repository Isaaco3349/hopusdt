# Firebase (Project settings → Your apps → Web app)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# TRON TRC20 USDT deposit (Binance TRON deposit for ops; do not label Binance on site)
BRIDGE_DEPOSIT_ADDRESS=

# Admin Firebase Auth emails (comma separated, must match users in Firebase Auth)
BRIDGE_ADMIN_EMAILS=you@example.com,cofounder@example.com

# Branding
BRIDGE_APP_NAME=USDT Hop
BRIDGE_TAGLINE=Send USDT on TRON, receive USDT on BNB Smart Chain. Transparent flat fee.

# Telegram support for customers (not the bot token)
# Examples: telegram:YourSupportUsername   or   https://t.me/YourSupportUsername
BRIDGE_SUPPORT_CONTACT=telegram:YourSupportUsername

# Economics (keep firestore.rules in sync — run npm run build after changes)
BRIDGE_FEE=1
BRIDGE_MIN_AMOUNT=2

# Operator Telegram alerts (Vercel only — server side /api/notify)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
